#!/usr/bin/env python3
"""Pick or import a wallpaper from Pictures/wallpaper and apply its colors."""
import hashlib
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys


def main():
    home = Path.home()
    collection = home / 'Pictures/wallpaper'
    collection.mkdir(parents=True, exist_ok=True)
    if len(sys.argv) == 2 and sys.argv[1] == '--select':
        images = sorted((p for p in collection.rglob('*') if p.is_file()
                         and p.suffix.lower() in ('.gif', '.jpg', '.jpeg', '.png', '.webp', '.avif', '.bmp', '.tif', '.tiff', '.svg')),
                        key=lambda p: str(p).casefold())
        if not images:
            raise ValueError('Pridaj obrázky do ~/Pictures/wallpaper.')
        rows = []
        cache = Path(os.environ.get('XDG_CACHE_HOME', home / '.cache')) / 'wallpaper-picker'
        cache.mkdir(parents=True, exist_ok=True)
        for image in images:
            thumb = cache / (hashlib.sha256(image.read_bytes()).hexdigest() + '.png')
            if not thumb.is_file():
                result = subprocess.run(['magick', str(image) + '[0]', '-auto-orient',
                                         '-thumbnail', '288x288', str(thumb)],
                                        capture_output=True, text=True)
                if result.returncode:
                    thumb.unlink(missing_ok=True)
            label = str(image.relative_to(collection)).replace('\n', ' ').replace('\r', ' ')
            icon = str(thumb if thumb.is_file() else image).replace('\n', '')
            rows.append(label + '\0icon\x1f' + icon)
        selected = subprocess.run(['rofi', '-dmenu', '-i', '-show-icons', '-format', 'i',
                                   '-p', 'Tapety', '-theme',
                                   str(Path(os.environ.get('XDG_CONFIG_HOME', home / '.config'))
                                       / 'rofi/wallpaper-picker.rasi')],
                                  input='\n'.join(rows) + '\n', capture_output=True, text=True)
        if selected.returncode != 0:
            return 0
        index = int(selected.stdout.strip())
        if not 0 <= index < len(images):
            raise ValueError('Neplatný výber tapety.')
        sys.argv[1] = str(images[index])
    if len(sys.argv) == 2 and sys.argv[1] in ('-h', '--help'):
        print('Použitie: wallpaper <obrázok alebo cesta>\nPríklad: wallpaper volvo.gif\nHľadá aj v ~/Pictures/wallpaper a ~/Pictures; pridá tapetu do výberu Mod + Shift + Q/W a nastaví farby.')
        return 0
    if len(sys.argv) != 2:
        raise ValueError('Použitie: wallpaper <obrázok alebo cesta>; cestu s medzerami daj do úvodzoviek.')
    arg = Path(sys.argv[1]).expanduser()
    source = next((p for p in (arg, collection / arg, home / 'Pictures' / arg) if p.is_file()), arg)
    if not source.is_file() and len(arg.parts) == 1 and not arg.suffix:
        matches = list({p.resolve() for folder in (collection, home / 'Pictures') for p in folder.glob('*')
                   if p.is_file() and p.stem == arg.name
                   and p.suffix.lower() in ('.gif', '.png', '.jpg', '.jpeg', '.webp', '.avif')})
        if len(matches) == 1:
            source = matches[0]
        elif len(matches) > 1:
            raise ValueError('Našiel som viac obrázkov; zadaj aj príponu.')
    if not source.is_file():
        raise ValueError(f'Obrázok sa nenašiel: {sys.argv[1]}')
    source = source.resolve()
    mime = subprocess.check_output(['file', '--mime-type', '-b', str(source)], text=True).strip()
    if not mime.startswith('image/'):
        raise ValueError('Zadaný súbor nie je obrázok ani GIF.')
    config = Path(os.environ.get('XDG_CONFIG_HOME', home / '.config'))
    state = Path(os.environ.get('XDG_STATE_HOME', home / '.local/state')) / 'hyde/staterc'
    contents = state.read_text()
    digest = hashlib.sha256(source.read_bytes()).hexdigest()
    target = collection / source.name
    if target.exists() and hashlib.sha256(target.read_bytes()).hexdigest() != digest:
        target = collection / f'{source.stem}-{digest}{source.suffix}'
    if not target.exists():
        shutil.copy2(source, target)
    # Preserve auto/dark/light; turn on wallpaper colors if theme colors were selected.
    updated, count = re.subn(r'^enableWallDcol=.*$',
                            lambda m: m[0] if re.fullmatch(r'enableWallDcol="?[123]"?', m[0]) else 'enableWallDcol="1"',
                            contents, flags=re.M)
    if not count:
        updated = contents.rstrip() + '\nenableWallDcol="1"\n'
    if updated != contents:
        state.write_text(updated)
    print(f'Tapeta uložená do výberu Mod + Shift + Q/W: {target.name}', flush=True)
    result = subprocess.run(['hyde-shell', 'wallpaper', '--set', str(target), '--global', '--filetypes', target.suffix.lstrip('.').lower()])
    if result.returncode:
        print('Tapeta je v zozname, ale aplikovanie sa nedokončilo. Skús príkaz znova v termináli grafickej relácie.', file=sys.stderr)
    return result.returncode


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        print(f'wallpaper: {exc}', file=sys.stderr)
        sys.exit(1)
